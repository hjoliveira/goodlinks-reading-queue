# Copy to .env and fill in. .env is gitignored — it holds a credential.
# The token is in GoodLinks under Settings -> API.
GOODLINKS_TOKEN=your-api-token

# Optional. Defaults shown.
# GOODLINKS_API=http://localhost:9428/api/v1

# Optional, goodlinks_server.py only.
# HOST=127.0.0.1
# PORT=8300

# Optional, goodlinks_mcp.py only. Default transport is stdio.
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8301
